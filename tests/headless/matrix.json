    {
      "id": "planet.exclude-platforms",
      "profile": "space-age",
      "runner": "integration",
      "status": "planned",
      "requirement": "Space-platform surfaces never receive terrestrial spawn generation or terrain mutation."
    },
    {
      "id": "planet.safe-profiles",
      "profile": "space-age",
      "runner": "integration",
      "status": "planned",
      "requirement": "Nauvis, Vulcanus, Fulgora, Gleba, and Aquilo use valid planet-specific terrain, resources, and enemy safety behavior."
    },
    {
      "id": "robot.count-by-network-and-force",
      "profile": "space-age",
      "runner": "integration",
      "status": "planned",
      "requirement": "Logistic and construction robots are counted independently per network, surface-force, and force."
    },
    {
      "id": "robot.no-silent-loss",
      "profile": "space-age",
      "runner": "integration",
      "status": "planned",
      "requirement": "Cap enforcement never destroys robots or carried items and exposes every held robot for recovery."
    },
    {
      "id": "robot.cap-overhead",
      "profile": "space-age",
      "runner": "benchmark",
      "status": "planned",
      "requirement": "Cap monitoring is benchmarked disabled, warning-only, and enforced across controlled robot and network counts."
    },
    {
      "id": "engine.baseline",
      "profile": "space-age",
      "runner": "benchmark",
      "status": "implemented",
      "requirement": "The current mod receives a repeatable headless engine baseline before controlled robot workloads are added."
